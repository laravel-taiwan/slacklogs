{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel-taiwan/slacklogs",
    "description": "Searchable PHP Taiwan Slack logs",
    "keywords": ["laravel", "slack", "taiwan"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.29",
        "mongodb/laravel-mongodb": "^5.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.8 || ^13.0.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
